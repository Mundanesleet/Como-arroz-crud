# Copia este archivo como ".env" para desarrollo local (opcional: sin él,
# el proyecto sigue funcionando igual que siempre, con SQLite y DEBUG=True).
#
# En producción (Render) estas mismas variables se configuran en el
# dashboard de Render, NO en un archivo .env.

# Clave secreta de Django. En producción, genera una nueva y única:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# "True" en local, "False" en producción.
DJANGO_DEBUG=True

# Dominios permitidos, separados por coma. En Render, agrega el dominio
# que te asigne, ej: como-arroz.onrender.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Igual que ALLOWED_HOSTS pero con el esquema completo (https://).
# Solo se necesita en producción.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Cadena de conexión de Postgres (Neon, Render Postgres, etc.).
# Si se deja vacía, se usa SQLite local (como hasta ahora).
DATABASE_URL=

# Cadena de conexión de Cloudinary (para las imágenes subidas).
# Si se deja vacía, las imágenes se guardan en el disco local (como hasta ahora).
CLOUDINARY_URL=
